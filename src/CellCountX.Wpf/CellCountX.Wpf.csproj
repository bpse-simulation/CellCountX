<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>favicon_bpse.ico</ApplicationIcon>

    <!-- 実行ファイル名を変更 -->
    <AssemblyName>CellCountX</AssemblyName>
  </PropertyGroup>

  <!-- ビルド構成 -->
  <PropertyGroup Condition="'$(Configuration)'=='ReleaseFull'">
    <DefineConstants>FULL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='ReleaseLight'">
    <DefineConstants>LIGHT</DefineConstants>
  </PropertyGroup>

  <!-- ZIP ファイル -->
  <ItemGroup>
    <PythonZip Include="python-3.12.10-embed-amd64.zip" />
  </ItemGroup>

  <!-- ============================
       ZIP 展開（Release / ReleaseFull）
       ============================ -->
  <Target Name="ExtractPythonZip"
          BeforeTargets="CopyPythonOnBuild;CopyPythonOnPublish"
          Condition="'$(Configuration)' == 'Release' OR '$(Configuration)' == 'ReleaseFull'">

    <PropertyGroup>
      <PythonExtractDir>$(IntermediateOutputPath)%(PythonZip.Filename)\</PythonExtractDir>
    </PropertyGroup>

    <MakeDir Directories="$(PythonExtractDir)" />

    <Unzip SourceFiles="@(PythonZip)"
           DestinationFolder="$(PythonExtractDir)" />
  </Target>

  <!-- ============================
       Build 時の Python コピー（Release / ReleaseFull）
       ============================ -->
  <Target Name="CopyPythonOnBuild"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' OR '$(Configuration)' == 'ReleaseFull'">

    <ItemGroup>
      <ExtractedPythonFiles Include="$(PythonExtractDir)**\*" />
      <PythonFiles Include="..\CellCountX.Py\cellpose\Lib\**\*"
                   Exclude="..\CellCountX.Py\cellpose\pyvenv.cfg;
                            ..\CellCountX.Py\cellpose\.gitignore;
                            ..\CellCountX.Py\cellpose\Lib\**\__pycache__\**" />
    </ItemGroup>

    <Copy SourceFiles="@(ExtractedPythonFiles)"
          DestinationFolder="$(OutDir)python\%(RecursiveDir)" />

    <Copy SourceFiles="@(PythonFiles)"
          DestinationFolder="$(OutDir)python\%(RecursiveDir)" />

    <Copy SourceFiles="python_embed\python312._pth.template"
          DestinationFiles="$(OutDir)python\python312._pth" />

    <Copy SourceFiles="..\CellCountX.Py\server.py"
          DestinationFolder="$(OutDir)" />

    <Copy SourceFiles="..\CellCountX.Py\remove_edge_cells.py"
          DestinationFolder="$(OutDir)" />

    <Copy SourceFiles="..\CellCountX.Py\overlay.py"
          DestinationFolder="$(OutDir)" />

    <Copy SourceFiles="..\CellCountX.Py\get_cellpose_info.py"
          DestinationFolder="$(OutDir)" />
  </Target>

  <!-- ============================
       Publish 時の Python コピー（Release / ReleaseFull）
       ============================ -->
  <Target Name="CopyPythonOnPublish"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' OR '$(Configuration)' == 'ReleaseFull'">

    <ItemGroup>
      <ExtractedPythonFiles Include="$(PythonExtractDir)**\*" />
      <PythonFiles Include="..\CellCountX.Py\cellpose\Lib\**\*"
                   Exclude="..\CellCountX.Py\cellpose\pyvenv.cfg;
                            ..\CellCountX.Py\cellpose\.gitignore;
                            ..\CellCountX.Py\cellpose\Lib\**\__pycache__\**" />
    </ItemGroup>

    <Copy SourceFiles="@(ExtractedPythonFiles)"
          DestinationFolder="$(PublishDir)python\%(RecursiveDir)" />

    <Copy SourceFiles="@(PythonFiles)"
          DestinationFolder="$(PublishDir)python\%(RecursiveDir)" />

    <Copy SourceFiles="python_embed\python312._pth.template"
          DestinationFiles="$(PublishDir)python\python312._pth" />
  </Target>

  <!-- ============================
       server.py などは Release / ReleaseFull / ReleaseLight 全てでコピー
       ============================ -->
  <Target Name="CopyPythonScripts"
          AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Release' OR '$(Configuration)' == 'ReleaseFull' OR '$(Configuration)' == 'ReleaseLight'">

    <Copy SourceFiles="..\CellCountX.Py\server.py"
          DestinationFolder="$(PublishDir)" />

    <Copy SourceFiles="..\CellCountX.Py\remove_edge_cells.py"
          DestinationFolder="$(PublishDir)" />

    <Copy SourceFiles="..\CellCountX.Py\overlay.py"
          DestinationFolder="$(PublishDir)" />

    <Copy SourceFiles="..\CellCountX.Py\get_cellpose_info.py"
          DestinationFolder="$(PublishDir)" />
  </Target>

  <!-- ============================
       Clean（Python 削除は Release のみ）
       ============================ -->
  <Target Name="CleanCopiedPython"
          BeforeTargets="Clean"
          Condition="'$(Configuration)' == 'Release'">

    <RemoveDir Directories="$(OutDir)python" />
    <RemoveDir Directories="$(PublishDir)python" />

    <Delete Files="$(OutDir)server.py" />
    <Delete Files="$(OutDir)remove_edge_cells.py" />
    <Delete Files="$(OutDir)overlay.py" />
    <Delete Files="$(OutDir)get_cellpose_info.py" />

    <Delete Files="$(PublishDir)server.py" />
    <Delete Files="$(PublishDir)remove_edge_cells.py" />
    <Delete Files="$(PublishDir)overlay.py" />
    <Delete Files="$(PublishDir)get_cellpose_info.py" />
  </Target>

  <!-- アイコン -->
  <ItemGroup>
    <Content Include="favicon_bpse.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
