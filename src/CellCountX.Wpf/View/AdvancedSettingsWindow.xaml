<Window x:Class="CellCountX.Wpf.View.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:CellCountX.Wpf.ViewModel"
        d:DataContext="{d:DesignInstance Type=viewmodel:AdvancedSettingsViewModel}"
        mc:Ignorable="d"
        Title="詳細設定" Height="300" Width="420"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイムアウト設定 -->
        <StackPanel Orientation="Vertical" Grid.Row="0">
            <TextBlock Text="タイムアウト（秒）" Margin="0 0 0 5"/>
            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                     Width="100"/>
            <TextBlock Text="※ 0 または空欄の場合は CPU/GPU に応じた自動設定になります"
                       FontSize="11" Foreground="Gray" Margin="0 5 0 0"/>
        </StackPanel>

        <!-- Cellpose モデル設定 -->
        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="0 10 0 0">
            <TextBlock Text="Cellpose モデル (.npy)" Margin="0 0 0 5"/>
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding CellposeModelPath, UpdateSourceTrigger=PropertyChanged}"
                         Width="260"/>
                <Button Content="参照..." Width="70" Margin="10 0 0 0"
                        Command="{Binding BrowseModelCommand}"/>
            </StackPanel>
            <TextBlock Text="※ 空欄の場合は Cellpose のデフォルトモデル（cpsam_v2）を使用します"
                       FontSize="11" Foreground="Gray" Margin="0 5 0 0"/>
        </StackPanel>

        <!-- OK / Cancel -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Right" Margin="0 20 0 0">
            <Button Content="OK" Width="80" Margin="0 0 10 0" Click="Ok_Click"/>
            <Button Content="キャンセル" Width="80" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
